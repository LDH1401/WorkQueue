# Cổng chạy API
PORT=5000

# Chuỗi kết nối MongoDB
# - Local:  mongodb://127.0.0.1:27017/workqueue
# - Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/workqueue
MONGO_URI=mongodb://127.0.0.1:27017/workqueue

# Khoá ký JWT - ĐỔI thành chuỗi ngẫu nhiên dài khi chạy thật
JWT_SECRET=doi-chuoi-nay-thanh-mot-khoa-bi-mat-that-dai
JWT_EXPIRES_IN=7d

# Origin của frontend (cho CORS), nhiều origin ngăn cách bằng dấu phẩy
CLIENT_URL=http://localhost:5173
